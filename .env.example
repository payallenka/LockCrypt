# copy this file to .env and change the values, .env is git-ignored

# MySQL root password, used by MySQLHandle (keys) and VaadinFramework (login accounts)
MYSQL_PASSWORD=change-me

# shared secret between VaadinFramework and the two storage services
# generate one with: openssl rand -hex 32
INTERNAL_TOKEN=change-me

# optional, use MongoDB Atlas instead of the local mongo container
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/LockCrypt
